SPDX-License-Identifier: GPL-2.0-only WITH Classpath-exception-2.0
Subject: [PATCH 6/6] Deny illegal native access, and argv grants, unless allowed
Upstream-Status: Inappropriate [fixed Werewolf appliance policy]
Reference: werewolf docs/design/hardened-interpreters.md
Base-Commit: 815ff4dc327fe17f2433c7d115a5a503af10f3c4

diff --git a/src/java.base/share/classes/jdk/internal/module/ModuleBootstrap.java b/src/java.base/share/classes/jdk/internal/module/ModuleBootstrap.java
--- a/src/java.base/share/classes/jdk/internal/module/ModuleBootstrap.java
+++ b/src/java.base/share/classes/jdk/internal/module/ModuleBootstrap.java
@@ -838,7 +838,10 @@
     }
 
     public static IllegalNativeAccess illegalNativeAccess() {
-        return ILLEGAL_NATIVE_ACCESS;
+        // Werewolf: denied unless the image allows java:native-access,
+        // whatever --illegal-native-access says.
+        return jdk.internal.misc.WerewolfAllowance.allowed("native-access")
+                ? ILLEGAL_NATIVE_ACCESS : IllegalNativeAccess.DENY;
     }
 
     public static IllegalFinalFieldMutation illegalFinalFieldMutation() {
@@ -856,7 +859,11 @@
     private static void addEnableNativeAccess(ModuleLayer layer) {
         String launcherMode = getAndRemoveProperty("sun.java.launcher.mode");
         boolean shouldWarn = !"source".equals(launcherMode);
-        addEnableNativeAccess(layer, USER_NATIVE_ACCESS_MODULES, shouldWarn);
+        // Werewolf: --enable-native-access grants nothing unless the image
+        // allows java:native-access; a JAR manifest still does.
+        if (jdk.internal.misc.WerewolfAllowance.allowed("native-access")) {
+            addEnableNativeAccess(layer, USER_NATIVE_ACCESS_MODULES, shouldWarn);
+        }
         addEnableNativeAccess(layer, JDK_NATIVE_ACCESS_MODULES, false);
     }
 
