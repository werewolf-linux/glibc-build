@@ -23,6 +23,63 @@
     private static final ConcurrentHashMap<String, Boolean> FOUND = new ConcurrentHashMap<>();
 
     private WerewolfAllowance() { }
+
+    private static String quote(String text, int limit, boolean[] truncated) {
+        if (text == null) text = "";
+        if (text.length() > limit) { text = text.substring(0, limit); truncated[0] = true; }
+        StringBuilder out = new StringBuilder("\"");
+        for (int i = 0; i < text.length(); i++) {
+            char c = text.charAt(i);
+            if (c == '"' || c == '\\') out.append('\\').append(c);
+            else if (c < 32 || c > 126) {
+                out.append("\\u");
+                for (int shift = 12; shift >= 0; shift -= 4) out.append("0123456789abcdef".charAt((c >> shift) & 15));
+            } else out.append(c);
+        }
+        return out.append('"').toString();
+    }
+
+    private static final class DenialOutput {
+        static final java.io.OutputStream ERR = new java.io.FileOutputStream(java.io.FileDescriptor.err);
+    }
+
+    /** Record actual refusals, even when the caller catches the exception. */
+    public static void denied(String group, String operation, String detail) {
+        try {
+            boolean[] truncated = {false};
+            StringBuilder args = new StringBuilder();
+            try (var input = Files.newInputStream(Path.of("/proc/self/cmdline"))) {
+                byte[] raw = input.readNBytes(257);
+                int length = Math.min(raw.length, 256), start = 0;
+                truncated[0] = raw.length > 256;
+                for (int i = 0; i < length; i++) {
+                    if (raw[i] == 0 || i + 1 == length) {
+                        int end = raw[i] == 0 ? i : i + 1;
+                        if (start > 0) args.append(',');
+                        args.append(quote(new String(raw, start, end - start, java.nio.charset.StandardCharsets.UTF_8), 256, truncated));
+                        start = i + 1;
+                    }
+                }
+            } catch (IOException ignored) { }
+            long euid = -1;
+            try {
+                for (String line : Files.readAllLines(Path.of("/proc/self/status"))) {
+                    if (line.startsWith("Uid:")) { euid = Long.parseLong(line.trim().split("\\s+")[2]); break; }
+                }
+            } catch (IOException | RuntimeException ignored) { }
+            String record = "{\"event\":\"runtime-denial\",\"time\":" + (System.currentTimeMillis() / 1000)
+                    + ",\"pid\":" + ProcessHandle.current().pid() + ",\"euid\":" + euid + ",\"runtime\":\"java\",\"group\":"
+                    + quote(group, 24, truncated) + ",\"operation\":" + quote(operation, 48, truncated)
+                    + ",\"detail\":" + quote(detail, 192, truncated) + ",\"argv\":[" + args
+                    + "],\"truncated\":" + truncated[0] + "}\n";
+            // Do not close or wrap System.err: applications may replace it.
+            synchronized (DenialOutput.ERR) {
+                DenialOutput.ERR.write(record.getBytes(java.nio.charset.StandardCharsets.US_ASCII));
+            }
+        } catch (IOException | RuntimeException | LinkageError ignored) {
+            // Failure to log must never turn a refusal into permission.
+        }
+    }
 
     /** Whether the image allows group: deserialize or native. */
     public static boolean allowed(String group) {
