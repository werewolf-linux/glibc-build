diff --git a/src/jdk.unsupported/share/classes/sun/misc/Unsafe.java b/src/jdk.unsupported/share/classes/sun/misc/Unsafe.java
--- a/src/jdk.unsupported/share/classes/sun/misc/Unsafe.java
+++ b/src/jdk.unsupported/share/classes/sun/misc/Unsafe.java
@@ -1853,6 +1853,11 @@
          * Return the value.
          */
         static MemoryAccessOption value() {
+            // Werewolf: denied unless the image allows java:unsafe, whatever
+            // --sun-misc-unsafe-memory-access says.
+            if (!jdk.internal.misc.WerewolfAllowance.allowed("native")) {
+                return MemoryAccessOption.DENY;
+            }
             String value = VM.getSavedProperty("sun.misc.unsafe.memory.access");
             if (value != null) {
                 return switch (value) {
