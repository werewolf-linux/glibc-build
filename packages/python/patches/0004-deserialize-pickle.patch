--- a/Modules/_pickle.c
+++ b/Modules/_pickle.c
@@ -7405,7 +7405,79 @@
 This method is called whenever a class or a function object is
 needed.  Both arguments passed are str objects.
 [clinic start generated code]*/
+
+#ifndef MS_WINDOWS
+#  include <fcntl.h>       // open
+#  include <sys/stat.h>    // lstat, S_ISREG
+#  include <unistd.h>      // read, close
+#endif
+
+#ifndef PY_RUNTIME_HARDENING_DIR
+#  define PY_RUNTIME_HARDENING_DIR "/etc/runtime-hardening/allow"
+#endif
+
+/* The service name: the last component of /proc/self/cgroup (cgroup v2,
+   "0::/svc/web" gives "web"). The supervisor places the process in that cgroup
+   as root and it cannot move itself out, so a compromised service cannot forge
+   it. Returns 0 and fills buf, or -1. */
+#ifndef MS_WINDOWS
+static int
+werewolf_service(char *buf, size_t size)
+{
+    int fd = open("/proc/self/cgroup", O_RDONLY | O_CLOEXEC);
+    if (fd < 0) {
+        return -1;
+    }
+    char line[512];
+    ssize_t n = read(fd, line, sizeof(line) - 1);
+    close(fd);
+    if (n <= 0) {
+        return -1;
+    }
+    line[n] = '\0';
+    char *newline = strchr(line, '\n');
+    if (newline != NULL) {
+        *newline = '\0';
+    }
+    char *slash = strrchr(line, '/');
+    if (slash == NULL || slash[1] == '\0' || strlen(slash + 1) >= size) {
+        return -1;
+    }
+    strcpy(buf, slash + 1);
+    return 0;
+}
+#endif
 
+/* Werewolf (docs/design/hardened-interpreters.md): a Python capability is
+   allowed only when /etc/runtime-hardening/allow/<ns>/python/<feature>, or
+   .../all/python/<feature>, is a regular file, never a symlink, on the
+   read-only root. <ns> is this service. argv and the environment grant
+   nothing. Fails closed. */
+static int
+werewolf_allowed(const char *feature)
+{
+#ifdef MS_WINDOWS
+    return 0;
+#else
+    struct stat st;
+    char path[4096];
+    char ns[256];
+    int k;
+    if (werewolf_service(ns, sizeof(ns)) == 0) {
+        k = snprintf(path, sizeof(path), "%s/%s/python/%s",
+                     PY_RUNTIME_HARDENING_DIR, ns, feature);
+        if (k > 0 && (size_t)k < sizeof(path) &&
+            lstat(path, &st) == 0 && S_ISREG(st.st_mode)) {
+            return 1;
+        }
+    }
+    k = snprintf(path, sizeof(path), "%s/all/python/%s",
+                 PY_RUNTIME_HARDENING_DIR, feature);
+    return k > 0 && (size_t)k < sizeof(path) &&
+           lstat(path, &st) == 0 && S_ISREG(st.st_mode);
+#endif
+}
+
 static PyObject *
 _pickle_Unpickler_find_class_impl(UnpicklerObject *self, PyTypeObject *cls,
                                   PyObject *module_name,
@@ -7415,6 +7487,14 @@
     PyObject *global;
     PyObject *module;
 
+    if (!werewolf_allowed("deserialize")) {
+        PickleState *st = _Pickle_GetStateByClass(cls);
+        PyErr_SetString(st->UnpicklingError,
+            "unpickling an object is refused: the image allows deserializing "
+            "untrusted bytes only by python:deserialize");
+        return NULL;
+    }
+
     if (PySys_Audit("pickle.find_class", "OO",
                     module_name, global_name) < 0) {
         return NULL;
diff --git a/Lib/pickle.py b/Lib/pickle.py
--- a/Lib/pickle.py
+++ b/Lib/pickle.py
@@ -32,6 +32,31 @@
 from struct import pack, unpack
 import io
 import codecs
+import os as _os
+import stat as _stat
+
+
+def _werewolf_deserialize_allowed():
+    # Werewolf (docs/design/hardened-interpreters.md): pickle reconstructs
+    # objects only where the image allows python:deserialize, a regular file,
+    # never a symlink, on the read-only root. <ns> is this service, the last
+    # component of /proc/self/cgroup, which the process cannot forge.
+    names = ['all']
+    try:
+        with open('/proc/self/cgroup', 'rb') as f:
+            leaf = f.readline().rstrip(b'\n').rsplit(b'/', 1)[-1]
+        if leaf:
+            names.insert(0, leaf.decode('ascii', 'replace'))
+    except OSError:
+        pass
+    for ns in names:
+        try:
+            info = _os.lstat('/etc/runtime-hardening/allow/%s/python/deserialize' % ns)
+        except OSError:
+            continue
+        if _stat.S_ISREG(info.st_mode):
+            return True
+    return False
 import _compat_pickle
 
 __all__ = ["PickleError", "PicklingError", "UnpicklingError", "Pickler",
@@ -1708,6 +1733,10 @@
 
