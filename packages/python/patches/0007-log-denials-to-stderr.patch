diff --git a/Python/sysmodule.c b/Python/sysmodule.c
--- a/Python/sysmodule.c
+++ b/Python/sysmodule.c
@@ -15,6 +15,7 @@
 */
 
 #include "Python.h"
+#include "internal/runtime_hardening_log.h"
 #include "pycore_audit.h"         // _Py_AuditHookEntry
 #include "pycore_call.h"          // _PyObject_CallNoArgs()
 #include "pycore_ceval.h"         // _PyEval_SetAsyncGenFinalizer()
@@ -2909,7 +2910,17 @@
     }
 }
 
+/* Used by the pure-Python unpickler; bypasses sys.stderr replacements. */
+static PyObject *sys_runtime_hardening_denied(PyObject *self, PyObject *args)
+{
+    const char *group, *operation, *detail;
+    if (!PyArg_ParseTuple(args, "sss", &group, &operation, &detail)) return NULL;
+    runtime_hardening_denied("python", group, operation, detail);
+    Py_RETURN_NONE;
+}
+
 static PyMethodDef sys_methods[] = {
+    {"_runtime_hardening_denied", sys_runtime_hardening_denied, METH_VARARGS, NULL},
     /* Might as well keep this in alphabetic order */
     SYS_ADDAUDITHOOK_METHODDEF
     SYS_AUDIT_METHODDEF
diff --git a/Lib/pickle.py b/Lib/pickle.py
--- a/Lib/pickle.py
+++ b/Lib/pickle.py
@@ -1734,6 +1734,7 @@
     def find_class(self, module, name):
         # Subclasses may override this.
         if not _werewolf_deserialize_allowed():
+            sys._runtime_hardening_denied('deserialize', 'pickle.find_class', module + '.' + name)
             raise UnpicklingError(
                 "unpickling an object is refused: the image allows "
                 "deserializing untrusted bytes only by python:deserialize")
