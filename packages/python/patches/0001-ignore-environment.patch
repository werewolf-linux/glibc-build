Subject: [PATCH 1/5] Ignore PYTHON* variables unless allowed, and the user site
Upstream-Status: Inappropriate [fixed Werewolf appliance policy]
Reference: werewolf docs/design/hardened-interpreters.md
Base-Commit: 626fb7612218cf10fbcf0525fce6b37c8a60d4be

diff --git a/Python/preconfig.c b/Python/preconfig.c
--- a/Python/preconfig.c
+++ b/Python/preconfig.c
@@ -278,7 +278,79 @@
 
 
 /* --- PyPreConfig ----------------------------------------------- */
+
+
+#ifndef MS_WINDOWS
+#  include <fcntl.h>       // open
+#  include <sys/stat.h>    // lstat, S_ISREG
+#  include <unistd.h>      // read, close
+#endif
+
+#ifndef PY_RUNTIME_HARDENING_DIR
+#  define PY_RUNTIME_HARDENING_DIR "/etc/runtime-hardening/allow"
+#endif
+
+/* The service name: the last component of /proc/self/cgroup (cgroup v2,
+   "0::/svc/web" gives "web"). The supervisor places the process in that cgroup
+   as root and it cannot move itself out, so a compromised service cannot forge
+   it. Returns 0 and fills buf, or -1. */
+#ifndef MS_WINDOWS
+static int
+werewolf_service(char *buf, size_t size)
+{
+    int fd = open("/proc/self/cgroup", O_RDONLY | O_CLOEXEC);
+    if (fd < 0) {
+        return -1;
+    }
+    char line[512];
+    ssize_t n = read(fd, line, sizeof(line) - 1);
+    close(fd);
+    if (n <= 0) {
+        return -1;
+    }
+    line[n] = '\0';
+    char *newline = strchr(line, '\n');
+    if (newline != NULL) {
+        *newline = '\0';
+    }
+    char *slash = strrchr(line, '/');
+    if (slash == NULL || slash[1] == '\0' || strlen(slash + 1) >= size) {
+        return -1;
+    }
+    strcpy(buf, slash + 1);
+    return 0;
+}
+#endif
 
+/* Werewolf (docs/design/hardened-interpreters.md): a Python capability is
+   allowed only when /etc/runtime-hardening/allow/<ns>/python/<feature>, or
+   .../all/python/<feature>, is a regular file, never a symlink, on the
+   read-only root. <ns> is this service. argv and the environment grant
+   nothing. Fails closed. */
+int
+_Py_RuntimeHardeningAllowed(const char *feature)
+{
+#ifdef MS_WINDOWS
+    return 0;
+#else
+    struct stat st;
+    char path[4096];
+    char ns[256];
+    int k;
+    if (werewolf_service(ns, sizeof(ns)) == 0) {
+        k = snprintf(path, sizeof(path), "%s/%s/python/%s",
+                     PY_RUNTIME_HARDENING_DIR, ns, feature);
+        if (k > 0 && (size_t)k < sizeof(path) &&
+            lstat(path, &st) == 0 && S_ISREG(st.st_mode)) {
+            return 1;
+        }
+    }
+    k = snprintf(path, sizeof(path), "%s/all/python/%s",
+                 PY_RUNTIME_HARDENING_DIR, feature);
+    return k > 0 && (size_t)k < sizeof(path) &&
+           lstat(path, &st) == 0 && S_ISREG(st.st_mode);
+#endif
+}
 
 void
 _PyPreConfig_InitCompatConfig(PyPreConfig *config)
@@ -316,7 +388,9 @@
     config->_config_init = (int)_PyConfig_INIT_PYTHON;
     config->isolated = 0;
     config->parse_argv = 1;
-    config->use_environment = 1;
+    /* Werewolf: PYTHON* variables are ignored, as with -E, unless the image
+       allows python:environment; see docs/design/hardened-interpreters.md. */
+    config->use_environment = _Py_RuntimeHardeningAllowed("environment");
     /* Set to -1 to enable C locale coercion (PEP 538) depending on
        the LC_CTYPE locale, PYTHONUTF8 and PYTHONCOERCECLOCALE
        environment variables. */
diff --git a/Python/initconfig.c b/Python/initconfig.c
--- a/Python/initconfig.c
+++ b/Python/initconfig.c
@@ -1219,7 +1219,10 @@
     config->tlbc_enabled = 1;
 #endif
 }
+
 
+/* Werewolf runtime-hardening allowance check (Python/preconfig.c). */
+extern int _Py_RuntimeHardeningAllowed(const char *feature);
 
 static void
 config_init_defaults(PyConfig *config)
@@ -1227,7 +1230,8 @@
     _PyConfig_InitCompatConfig(config);
 
     config->isolated = 0;
-    config->use_environment = 1;
+    /* Werewolf: as -E, unless the image allows python:environment. */
+    config->use_environment = _Py_RuntimeHardeningAllowed("environment");
     config->site_import = 1;
     config->bytes_warning = 0;
     config->inspect = 0;
@@ -1237,7 +1241,7 @@
     config->write_bytecode = 1;
     config->verbose = 0;
     config->quiet = 0;
-    config->user_site_directory = 1;
+    config->user_site_directory = 0;  /* Werewolf: -s always, no user site. */
     config->buffered_stdio = 1;
     config->pathconfig_warnings = 1;
 #ifdef MS_WINDOWS
