Subject: [PATCH 3/3] Load _ctypes only where the image allows it
Upstream-Status: Inappropriate [fixed Werewolf appliance policy]
Reference: werewolf docs/design/hardened-interpreters.md
Base-Commit: 626fb7612218cf10fbcf0525fce6b37c8a60d4be

diff --git a/Modules/_ctypes/_ctypes.c b/Modules/_ctypes/_ctypes.c
--- a/Modules/_ctypes/_ctypes.c
+++ b/Modules/_ctypes/_ctypes.c
@@ -6386,9 +6386,33 @@
 }
 
 
+#ifndef PY_WEREWOLF_ALLOW_DIR
+#  define PY_WEREWOLF_ALLOW_DIR "/etc/werewolf/allow/python"
+#endif
+
+/* Werewolf (docs/design/hardened-interpreters.md): code that writes its
+   process's memory can remove any check, so _ctypes loads only where the
+   image allows it: an empty regular file, never a link, on its root. */
+static int
+werewolf_ctypes_allowed(void)
+{
+#ifdef MS_WIN32
+    return 0;
+#else
+    struct stat st;
+    return lstat(PY_WEREWOLF_ALLOW_DIR "/ctypes", &st) == 0 && S_ISREG(st.st_mode);
+#endif
+}
+
 static int
 _ctypes_mod_exec(PyObject *mod)
 {
+    if (!werewolf_ctypes_allowed()) {
+        PyErr_SetString(PyExc_ImportError,
+            "ctypes is refused: the image allows it only by "
+            PY_WEREWOLF_ALLOW_DIR "/ctypes (form.yaml allow: [python:ctypes])");
+        return -1;
+    }
     // See https://github.com/python/cpython/issues/128485
     // This allocates some memory and then frees it to ensure that the
     // the dlmalloc allocator initializes itself to avoid data races
