SPDX-License-Identifier: PHP-3.01
Subject: [PATCH 8/9] Refuse inline code (-r, -R, -B, -E) unless allowed
Upstream-Status: Inappropriate [fixed Werewolf appliance policy]
Reference: werewolf docs/design/hardened-interpreters.md
Base-Commit: 678778973bb4d4185c06ef1320de50f1a975d3c8

diff --git a/sapi/cli/php_cli.c b/sapi/cli/php_cli.c
--- a/sapi/cli/php_cli.c
+++ b/sapi/cli/php_cli.c
@@ -941,6 +941,13 @@
 		zend_is_auto_global(ZSTR_KNOWN(ZEND_STR_AUTOGLOBAL_SERVER));
 
 		PG(during_request_startup) = 0;
+		if ((context.mode == PHP_CLI_MODE_CLI_DIRECT || context.mode == PHP_CLI_MODE_PROCESS_STDIN)
+				&& !php_werewolf_allowed("inline")) {
+			fprintf(stderr, "php: inline code (-r, -R, -B, -E) is refused; the image "
+					"allows it only by php:inline\n");
+			EG(exit_status) = 1;
+			goto out;
+		}
 		switch (context.mode) {
 		case PHP_CLI_MODE_STANDARD:
 			cli_register_file_handles();
