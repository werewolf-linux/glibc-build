SPDX-License-Identifier: PHP-3.01
Subject: [PATCH] Refuse runtime initialization with effective UID 0
Upstream-Status: Inappropriate [fixed Werewolf appliance policy]
Reference: werewolf docs/design/hardened-interpreters.md

diff --git a/main/main.c b/main/main.c
--- a/main/main.c
+++ b/main/main.c
@@ -20,6 +20,7 @@
 
 #define ZEND_INCLUDE_FULL_WINDOWS_HEADERS
 
 #include "php.h"
+#include "runtime_hardening_root.h"
 #include <stdio.h>
 #include <fcntl.h>
@@ -2316,6 +2317,10 @@
 /* {{{ php_module_startup */
 zend_result php_module_startup(sapi_module_struct *sf, zend_module_entry *additional_module)
 {
+	if (runtime_hardening_root_refused()) {
+		fprintf(stderr, "php: refusing effective UID 0\n");
+		return FAILURE;
+	}
 	zend_utility_functions zuf;
 	zend_utility_values zuv;
 	zend_result retval = SUCCESS;
diff --git a/main/runtime_hardening_root.h b/main/runtime_hardening_root.h
--- /dev/null
+++ b/main/runtime_hardening_root.h
@@ -0,0 +1,21 @@
+/* Runtime startup refuses effective root. The build marker is never packaged.
+ * No argv, environment variable, or supported runtime allowance opens this. */
+#ifndef RUNTIME_HARDENING_ROOT_H
+#define RUNTIME_HARDENING_ROOT_H
+#ifndef _WIN32
+#include <sys/stat.h>
+#include <unistd.h>
+#ifndef RUNTIME_HARDENING_BUILD_ROOT
+#define RUNTIME_HARDENING_BUILD_ROOT "/etc/runtime-hardening/build-root"
+#endif
+static int runtime_hardening_root_refused(void) {
+    struct stat st;
+    if (geteuid() != 0) return 0;
+    return !(lstat(RUNTIME_HARDENING_BUILD_ROOT, &st) == 0 &&
+             S_ISREG(st.st_mode) && st.st_uid == 0 &&
+             (st.st_mode & 0022) == 0);
+}
+#else
+static int runtime_hardening_root_refused(void) { return 1; }
+#endif
+#endif
