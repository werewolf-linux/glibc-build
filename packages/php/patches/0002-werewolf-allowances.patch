Subject: [PATCH 2/9] Read capability-group allowances from the read-only root
Upstream-Status: Inappropriate [fixed Werewolf appliance policy]
Reference: werewolf docs/design/hardened-interpreters.md
Base-Commit: 678778973bb4d4185c06ef1320de50f1a975d3c8

diff --git a/main/main.c b/main/main.c
--- a/main/main.c
+++ b/main/main.c
@@ -23,6 +23,8 @@
 #include "php.h"
 #include <stdio.h>
 #include <fcntl.h>
+#include <sys/stat.h>
+#include <unistd.h>
 #ifdef PHP_WIN32
 #include "win32/time.h"
 #include "win32/signal.h"
@@ -766,9 +768,83 @@
 			return FAILURE;
 	}
 	return SUCCESS;
+}
+/* }}} */
+
+#ifndef PHP_RUNTIME_HARDENING_DIR
+# define PHP_RUNTIME_HARDENING_DIR "/etc/runtime-hardening/allow"
+#endif
+
+#ifndef PHP_WIN32
+/* {{{ php_werewolf_service
+ * The service: the last component of /proc/self/cgroup (cgroup v2,
+ * "0::/svc/web" gives "web"), set by the supervisor as root and unchangeable
+ * by the service, so it cannot be forged. Returns its length, or 0. */
+static size_t php_werewolf_service(char *buf, size_t size)
+{
+	int fd = open("/proc/self/cgroup", O_RDONLY | O_CLOEXEC);
+	if (fd < 0) {
+		return 0;
+	}
+	char line[512];
+	ssize_t n = read(fd, line, sizeof(line) - 1);
+	close(fd);
+	if (n <= 0) {
+		return 0;
+	}
+	line[n] = '\0';
+	char *nl = strchr(line, '\n');
+	if (nl != NULL) {
+		*nl = '\0';
+	}
+	char *slash = strrchr(line, '/');
+	if (slash == NULL || slash[1] == '\0') {
+		return 0;
+	}
+	size_t len = strlen(slash + 1);
+	if (len >= size) {
+		return 0;
+	}
+	memcpy(buf, slash + 1, len + 1);
+	return len;
 }
 /* }}} */
 
+/* {{{ php_werewolf_file */
+static bool php_werewolf_file(const char *ns, const char *group)
+{
+	char path[MAXPATHLEN];
+	struct stat st;
+	int n = snprintf(path, sizeof(path), "%s/%s/php/%s", PHP_RUNTIME_HARDENING_DIR, ns, group);
+
+	if (n < 0 || (size_t) n >= sizeof(path)) {
+		return false;
+	}
+	return fstatat(AT_FDCWD, path, &st, AT_SYMLINK_NOFOLLOW) == 0 && S_ISREG(st.st_mode);
+}
+/* }}} */
+#endif
+
+/* {{{ php_werewolf_allowed
+ * Whether the image allows a capability group for PHP: an empty regular file,
+ * never a symlink (a lock-time link is refused until PHP reads one), at
+ * PHP_RUNTIME_HARDENING_DIR/<ns>/php/<group> for this service, or .../all/php/
+ * <group> for every service. php.ini, argv and the environment allow nothing. */
+PHPAPI bool php_werewolf_allowed(const char *group)
+{
+#ifdef PHP_WIN32
+	return false;
+#else
+	char ns[256];
+
+	if (php_werewolf_service(ns, sizeof(ns)) > 0 && php_werewolf_file(ns, group)) {
+		return true;
+	}
+	return php_werewolf_file("all", group);
+#endif
+}
+/* }}} */
+
 /* defined in browscap.c */
 PHP_INI_MH(OnChangeBrowscap);
 
diff --git a/main/php.h b/main/php.h
--- a/main/php.h
+++ b/main/php.h
@@ -283,6 +283,10 @@
 PHPAPI bool php_during_module_startup(void);
 PHPAPI bool php_during_module_shutdown(void);
 PHPAPI bool php_get_module_initialized(void);
+/* Werewolf (docs/design/hardened-interpreters.md): whether the image allows a
+ * capability group for PHP, an empty regular file in the runtime-hardening tree
+ * on the read-only root. php.ini, argv and the environment allow nothing. */
+PHPAPI bool php_werewolf_allowed(const char *group);
 #ifdef HAVE_SYSLOG_H
 #include "php_syslog.h"
 #define php_log_err(msg) php_log_err_with_severity(msg, LOG_NOTICE)
