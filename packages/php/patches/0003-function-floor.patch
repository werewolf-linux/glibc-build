Subject: [PATCH 3/9] Disable the exec and native function groups unless allowed
Upstream-Status: Inappropriate [fixed Werewolf appliance policy]
Reference: werewolf docs/design/hardened-interpreters.md
Base-Commit: 678778973bb4d4185c06ef1320de50f1a975d3c8

diff --git a/main/main.c b/main/main.c
--- a/main/main.c
+++ b/main/main.c
@@ -842,6 +842,27 @@
 	}
 	return php_werewolf_file("all", group);
 #endif
+}
+/* }}} */
+
+/* {{{ php_werewolf_disable_floor
+ * The exec group (programs) and the native group (dl, loading a shared object)
+ * stay disabled whatever php.ini says, unless the image allows the group.
+ * Grouping means moving from popen to system needs no new grant. */
+static void php_werewolf_disable_floor(void)
+{
+	static const char *const spawn[] = {
+		"exec", "passthru", "pcntl_exec", "popen", "proc_open", "shell_exec", "system",
+	};
+
+	if (!php_werewolf_allowed("exec")) {
+		for (size_t i = 0; i < sizeof(spawn) / sizeof(spawn[0]); i++) {
+			zend_disable_functions(spawn[i]);
+		}
+	}
+	if (!php_werewolf_allowed("native")) {
+		zend_disable_functions("dl");
+	}
 }
 /* }}} */
 
@@ -2444,6 +2465,7 @@
 
 	/* disable certain functions as requested by php.ini */
 	zend_disable_functions(INI_STR("disable_functions"));
+	php_werewolf_disable_floor();
 
 	/* make core report what it should */
 	if ((module = zend_hash_str_find_ptr(&module_registry, "core", sizeof("core")-1)) != NULL) {
