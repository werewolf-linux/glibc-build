  * The exec group (programs) and the native group (dl, loading a shared object)
  * stay disabled whatever php.ini says, unless the image allows the group.
  * Grouping means moving from popen to system needs no new grant. */
+static void php_werewolf_undefined_function(const char *name)
+{
+    static const char *const spawn[] = {
+        "exec", "passthru", "pcntl_exec", "popen", "proc_open", "shell_exec", "system",
+    };
+    const char *group = NULL;
+    for (size_t i = 0; i < sizeof(spawn) / sizeof(spawn[0]); i++) {
+        if (strcasecmp(name, spawn[i]) == 0) group = "exec";
+    }
+    if (strcasecmp(name, "dl") == 0) group = "native";
+    if (group && !php_werewolf_allowed(group)) {
+        char location[256];
+        snprintf(location, sizeof(location), "%s:%u", zend_get_executed_filename(), zend_get_executed_lineno());
+        runtime_hardening_denied("php", group, name, location);
+    }
+}
+
 static void php_werewolf_disable_floor(void)
 {
 	static const char *const spawn[] = {
@@ -876,6 +894,7 @@
 static PHP_INI_MH(OnUpdateAllowUrlInclude)
 {
 	if (new_value && zend_ini_parse_bool(new_value)) {
+		runtime_hardening_denied("php", "url-include", "configure", "allow_url_include=1");
 		zend_error(E_WARNING, "allow_url_include=1 refused: werewolf never includes code from a URL");
 		return FAILURE;
 	}
@@ -2305,6 +2324,8 @@
 	if (file_handle != NULL && file_handle->primary_script
 			&& !php_werewolf_allowed("writable-source")
 			&& php_werewolf_writable_source(file_handle)) {
+		zend_string *path = file_handle->opened_path ? file_handle->opened_path : file_handle->filename;
+		runtime_hardening_denied("php", "writable-source", "execute", path ? ZSTR_VAL(path) : "");
 		zend_throw_error(NULL, "running a script from a writable mount is refused: "
 			"the image allows it only by php:writable-source");
 		return NULL;
@@ -2318,6 +2339,7 @@
 zend_result php_module_startup(sapi_module_struct *sf, zend_module_entry *additional_module)
 {
 	if (runtime_hardening_root_refused()) {
+		runtime_hardening_denied("php", "root", "startup", "effective UID 0");
 		fprintf(stderr, "php: refusing effective UID 0\n");
 		return FAILURE;
 	}
@@ -2520,6 +2542,7 @@
 	/* disable certain functions as requested by php.ini */
 	zend_disable_functions(INI_STR("disable_functions"));
 	php_werewolf_disable_floor();
+	zend_runtime_hardening_undefined_function = php_werewolf_undefined_function;
 	php_werewolf_unserialize_objects = php_werewolf_allowed("deserialize");
 
 	/* make core report what it should */
