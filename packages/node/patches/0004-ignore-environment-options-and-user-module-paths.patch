Subject: [PATCH] Ignore environment options and user module paths
Upstream-Status: Inappropriate [fixed Werewolf appliance policy]
Reference: werewolf docs/design/hardened-interpreters.md
Base-Commit: 26e72d85a611e222e3f06025de8a3c496923bacd

diff --git a/src/node_credentials.cc b/src/node_credentials.cc
--- a/src/node_credentials.cc
+++ b/src/node_credentials.cc
@@ -1,4 +1,5 @@
 #include "env-inl.h"
+#include "node_hardening.h"
 #include "node_errors.h"
 #include "node_external_reference.h"
 #include "node_internals.h"
@@ -72,6 +73,10 @@
 // process does not have any capabilities set and the process is running as
 // setuid root then lookup will not be allowed.
 bool SafeGetenv(const char* key, std::string* text, Environment* env) {
+  if (!hardening::Allowed("environment") &&
+      (strncmp(key, "NODE_", 5) == 0 || strncmp(key, "OPENSSL_", 8) == 0)) {
+    return false;
+  }
 #if !defined(__CloudABI__) && !defined(_WIN32)
 #if defined(__linux__)
   if ((!HasOnly(CAP_NET_BIND_SERVICE) && linux_at_secure()) ||
diff --git a/src/node_options.cc b/src/node_options.cc
--- a/src/node_options.cc
+++ b/src/node_options.cc
@@ -1,4 +1,5 @@
-#include "node_options.h"  // NOLINT(build/include_inline)
+#include "node_options.h"
+#include "node_hardening.h"  // NOLINT(build/include_inline)
 #include "node_options-inl.h"
 
 #include "env-inl.h"
@@ -2527,6 +2528,7 @@
 
 void HandleEnvOptions(std::shared_ptr<EnvironmentOptions> env_options,
                       std::function<std::string(const char*)> opt_getter) {
+  if (!hardening::Allowed("environment")) return;
   env_options->pending_deprecation =
       opt_getter("NODE_PENDING_DEPRECATION") == "1";
 
