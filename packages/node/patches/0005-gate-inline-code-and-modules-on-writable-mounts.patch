SPDX-License-Identifier: MIT
Subject: [PATCH] Gate inline code and modules on writable mounts
Upstream-Status: Inappropriate [fixed Werewolf appliance policy]
Reference: werewolf docs/design/hardened-interpreters.md
Base-Commit: 26e72d85a611e222e3f06025de8a3c496923bacd

diff --git a/src/node_credentials.cc b/src/node_credentials.cc
--- a/src/node_credentials.cc
+++ b/src/node_credentials.cc
@@ -103,6 +103,22 @@
   return has_env;
 }
 
+static void WerewolfInline(const FunctionCallbackInfo<Value>& args) {
+  Environment* env = Environment::GetCurrent(args);
+  if (!hardening::Allowed("inline")) {
+    THROW_ERR_ACCESS_DENIED(env, "node:inline required for code from strings or stdin");
+  }
+}
+
+static void WerewolfSource(const FunctionCallbackInfo<Value>& args) {
+  Environment* env = Environment::GetCurrent(args);
+  CHECK(args[0]->IsString());
+  Utf8Value filename(env->isolate(), args[0]);
+  if (!hardening::SourceAllowed(*filename)) {
+    THROW_ERR_ACCESS_DENIED(env, "node:writable-source required for code on a writable or unknown mount");
+  }
+}
+
 static void SafeGetenv(const FunctionCallbackInfo<Value>& args) {
   CHECK(args[0]->IsString());
   Environment* env = Environment::GetCurrent(args);
@@ -477,6 +493,8 @@
 void RegisterExternalReferences(ExternalReferenceRegistry* registry) {
   registry->Register(SafeGetenv);
   registry->Register(GetTempDir);
+  registry->Register(WerewolfInline);
+  registry->Register(WerewolfSource);
 
 #ifdef NODE_IMPLEMENTS_POSIX_CREDENTIALS
   registry->Register(GetUid);
@@ -500,6 +518,8 @@
                        void* priv) {
   SetMethod(context, target, "safeGetenv", SafeGetenv);
   SetMethod(context, target, "getTempDir", GetTempDir);
+  SetMethod(context, target, "werewolfInline", WerewolfInline);
+  SetMethod(context, target, "werewolfSource", WerewolfSource);
 
 #ifdef NODE_IMPLEMENTS_POSIX_CREDENTIALS
   Environment* env = Environment::GetCurrent(context);
