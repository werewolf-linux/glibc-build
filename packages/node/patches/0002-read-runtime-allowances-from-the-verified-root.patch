Subject: [PATCH] Read runtime allowances from the verified root
Upstream-Status: Inappropriate [fixed Werewolf appliance policy]
Reference: werewolf docs/design/hardened-interpreters.md
Base-Commit: 26e72d85a611e222e3f06025de8a3c496923bacd

diff --git a/src/node_hardening.h b/src/node_hardening.h
--- /dev/null
+++ b/src/node_hardening.h
@@ -0,0 +1,48 @@
+// SPDX-License-Identifier: MIT
+#ifndef SRC_NODE_HARDENING_H_
+#define SRC_NODE_HARDENING_H_
+#include <cstdio>
+#include <cstring>
+#include <string>
+#include <sys/stat.h>
+#include <sys/statvfs.h>
+#include <fcntl.h>
+#include <unistd.h>
+
+namespace node::hardening {
+#ifndef NODE_RUNTIME_HARDENING_DIR
+#define NODE_RUNTIME_HARDENING_DIR "/etc/runtime-hardening/allow"
+#endif
+inline bool File(const char* ns, const char* group) {
+  std::string path = std::string(NODE_RUNTIME_HARDENING_DIR) + "/" + ns +
+                     "/node/" + group;
+  struct stat st;
+  return lstat(path.c_str(), &st) == 0 && S_ISREG(st.st_mode);
+}
+inline bool Allowed(const char* group) {
+  // cgroup v2 identity is assigned by the supervisor, never by argv or env.
+  int fd = open("/proc/self/cgroup", O_RDONLY | O_CLOEXEC);
+  if (fd >= 0) {
+    char line[4096];
+    ssize_t n = read(fd, line, sizeof(line) - 1);
+    close(fd);
+    if (n > 0 && n < static_cast<ssize_t>(sizeof(line) - 1)) {
+      line[n] = '\0';
+      char* end = strchr(line, '\n');
+      if (end) *end = '\0';
+      char* slash = strrchr(line, '/');
+      if (strncmp(line, "0::/", 4) == 0 && slash && slash[1] &&
+          strcmp(slash + 1, ".") && strcmp(slash + 1, "..") &&
+          File(slash + 1, group)) return true;
+    }
+  }
+  return File("all", group);
+}
+inline bool SourceAllowed(const char* filename) {
+  if (Allowed("writable-source")) return true;
+  struct statvfs st;
+  // Unknown provenance fails closed, including virtual and missing files.
+  return statvfs(filename, &st) == 0 && (st.f_flag & ST_RDONLY);
+}
+}  // namespace node::hardening
+#endif
