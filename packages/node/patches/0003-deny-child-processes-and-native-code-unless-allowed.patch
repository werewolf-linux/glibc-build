+// This floor applies with permissions disabled, in audit mode, in workers,
+// and below JS wrappers. --allow-* never grants an image capability.
+inline bool HardeningGranted(PermissionScope permission) {
+  switch (permission) {
+    case PermissionScope::kChildProcess: return hardening::Allowed("exec");
+    case PermissionScope::kAddon:
+    case PermissionScope::kFFI:
+    case PermissionScope::kWASI:
+    case PermissionScope::kOpenSSLStore: return hardening::Allowed("native");
+    default: return true;
+  }
+}
+
 class Permission {
  public:
   Permission();
@@ -91,6 +108,7 @@
   FORCE_INLINE bool is_granted(Environment* env,
                                PermissionScope permission,
                                std::string_view res = "") const {
+    if (!HardeningGranted(permission)) return false;
     if (!enabled_) [[likely]] {
       return true;
     }
