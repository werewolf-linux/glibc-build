Subject: [PATCH 4/4] Retain built-in converters without external configuration or DSOs
Upstream-Status: Inappropriate [fixed Werewolf appliance policy]
Reference: docs/glibc-vuln-audit.md; docs/design/glibc-neutered.md
Base-Commit: 34106fee698c83eb0af71d4d0381e66b399be746

diff --git a/iconv/gconv_conf.c b/iconv/gconv_conf.c
index a1f10ea8..05a9cc01 100644
--- a/iconv/gconv_conf.c
+++ b/iconv/gconv_conf.c
@@ -464,22 +464,7 @@ __gconv_read_conf (void)
   int save_errno = errno;
   size_t cnt;
 
-  /* First see whether we should use the cache.  */
-  if (__gconv_load_cache () == 0)
-    {
-      /* Yes, we are done.  */
-      __set_errno (save_errno);
-      return;
-    }
-
-#ifndef STATIC_GCONV
-  /* Find out where we have to look.  */
-  __gconv_get_path ();
-
-  for (cnt = 0; __gconv_path_elem[cnt].name != NULL; ++cnt)
-    gconv_parseconfdir (NULL, __gconv_path_elem[cnt].name,
-			__gconv_path_elem[cnt].len);
-#endif
+  /* External converter configuration and caches are disabled.  */
 
   /* Add the internal modules.  */
   for (cnt = 0; cnt < sizeof (builtin_modules) / sizeof (builtin_modules[0]);
diff --git a/iconv/gconv_dl.c b/iconv/gconv_dl.c
index 5d150ae2..7107853a 100644
--- a/iconv/gconv_dl.c
+++ b/iconv/gconv_dl.c
@@ -65,6 +65,8 @@ known_compare (const void *p1, const void *p2)
 struct __gconv_loaded_object *
 __gconv_find_shlib (const char *name)
 {
+  /* Built-in conversions never require a shared object.  */
+  return NULL;
   struct __gconv_loaded_object *found;
   void *keyp;
 
