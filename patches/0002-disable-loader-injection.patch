diff --git a/elf/dl-load.c b/elf/dl-load.c
index 47147864..d146285d 100644
--- a/elf/dl-load.c
+++ b/elf/dl-load.c
@@ -1290,6 +1290,13 @@ _dl_map_object_from_fd (const char *name, const char *origname, int fd,
 
   elf_get_dynamic_info (l, false, false);
 
+  if (l->l_info[ADDRIDX (DT_AUDIT)] != NULL
+      || l->l_info[ADDRIDX (DT_DEPAUDIT)] != NULL)
+    {
+      errstring = N_("ELF audit requests are disabled");
+      goto lose;
+    }
+
   /* Make sure we are not dlopen'ing an object that has the
      DF_1_NOOPEN flag set, or a PIE object.  */
   if ((__glibc_unlikely (l->l_flags_1 & DF_1_NOOPEN)
diff --git a/elf/ldd.bash.in b/elf/ldd.bash.in
index bfc40f65..6bad3be8 100644
--- a/elf/ldd.bash.in
+++ b/elf/ldd.bash.in
@@ -48,10 +48,6 @@ warranty; not even for MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
     echo $"Usage: ldd [OPTION]... FILE...
       --help              print this help and exit
       --version           print version information and exit
-  -d, --data-relocs       process data relocations
-  -r, --function-relocs   process data and function relocations
-  -u, --unused            print unused direct dependencies
-  -v, --verbose           print all information
 "
     printf $"For bug reporting instructions, please see:\\n%s.\\n" \
       "@REPORT_BUGS_TO@"
@@ -101,6 +97,11 @@ nonelf ()
   return 1;
 }
 
+if test -n "$warn$bind_now$verbose$unused"; then
+  echo >&2 'ldd: optional loader controls are disabled'
+  exit 1
+fi
+
 add_env="LD_TRACE_LOADED_OBJECTS=1 LD_WARN=$warn LD_BIND_NOW=$bind_now"
 add_env="$add_env LD_VERBOSE=$verbose"
 if test "$unused" = yes; then
@@ -114,7 +115,7 @@ fi
 # subshell compound list (using "(...)") to prevent parameter assignments from
 # affecting the calling shell execution environment.
 try_trace() (
-  output=$(eval $add_env '"$@"' 2>&1; rc=$?; printf 'x'; exit $rc)
+  output=$("$1" --list "$2" 2>&1; rc=$?; printf 'x'; exit $rc)
   rc=$?
   printf '%s' "${output%x}"
   return $rc
