+            || !strcmp (_dl_argv[1], "--library-path")
+            || !strcmp (_dl_argv[1], "--inhibit-rpath")
+            || !strcmp (_dl_argv[1], "--inhibit-cache")
+            || !strcmp (_dl_argv[1], "--glibc-hwcaps-prepend")
