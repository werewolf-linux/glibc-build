 {
+  _dl_fatal_printf ("ld.so: preloading is disabled\n");
   const char *objname;
   const char *err_str = NULL;
   struct map_args args;
@@ -907,6 +908,7 @@
 static void
 load_audit_module (const char *name, struct audit_ifaces **last_audit)
 {
+  _dl_fatal_printf ("ld.so: audit modules are disabled\n");
   int original_tls_idx = GL(dl_tls_max_dtv_idx);
 
   struct dlmopen_args dlmargs;
@@ -1392,7 +1394,15 @@
       _dl_rtld_map.l_name = rtld_progname;
 
       while (_dl_argc > 1)
-	if (! strcmp (_dl_argv[1], "--list"))
