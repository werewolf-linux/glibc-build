Subject: [PATCH 2/4] Disable loader injection and command-line search overrides
Upstream-Status: Inappropriate [fixed Werewolf appliance policy]
Reference: docs/glibc-vuln-audit.md; docs/design/glibc-neutered.md
Base-Commit: 34106fee698c83eb0af71d4d0381e66b399be746

--- a/elf/rtld.c
+++ b/elf/rtld.c
@@ -221,7 +221,7 @@
   ElfW(Dyn) *info = main_map->l_info[ADDRIDX (tag)];
   const char *strtab = (const char *) D_PTR (main_map, l_info[DT_STRTAB]);
   if (info != NULL)
-    audit_list_add_string (list, strtab + info->d_un.d_val);
+    _dl_fatal_printf ("ld.so: ELF audit requests are disabled\n");
 }
 
 static const char *
@@ -783,6 +783,7 @@
 static unsigned int
